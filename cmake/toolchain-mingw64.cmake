set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

if(NOT DEFINED MINGW_PREFIX)
    set(MINGW_PREFIX x86_64-w64-mingw32)
endif()

find_program(MINGW64_C_POSIX NAMES ${MINGW_PREFIX}-gcc-posix ${MINGW_PREFIX}-gcc)
find_program(MINGW64_CXX_POSIX NAMES ${MINGW_PREFIX}-g++-posix ${MINGW_PREFIX}-g++)
find_program(MINGW64_RC NAMES ${MINGW_PREFIX}-windres)

set(CMAKE_C_COMPILER "${MINGW64_C_POSIX}")
set(CMAKE_CXX_COMPILER "${MINGW64_CXX_POSIX}")
set(CMAKE_RC_COMPILER "${MINGW64_RC}")

set(CMAKE_FIND_ROOT_PATH /usr/${MINGW_PREFIX})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
