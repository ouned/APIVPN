root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Trailing double-space is meaningful in Markdown line breaks.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sln,vcxproj,vcxproj.filters}]
end_of_line = crlf
